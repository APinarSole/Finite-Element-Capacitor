import numpy as np
from scipy.ndimage import convolve, generate_binary_structure
from numba import njit
import os
import re
import matplotlib.pyplot as plt
import scipy.optimize
import nanonispy2 as nap
from scipy.optimize import curve_fit
from scipy.ndimage import gaussian_filter1d
from scipy.interpolate import RectBivariateSpline
from scipy.spatial.distance import cdist
from scipy.constants import e, epsilon_0
import time



# Parameters

V0 = 1     # Potential difference between plates
q = 0      # point charge in q units 
L = 1      # Length size of capacitor plates (m)
d = 1.4      # Distance separation between plates (only for contour plot) (m)
point_density = 100  # Points per m
size_grid = 2 #lateral lenght of the grid in meters, mind the plate lenght and d to fit in (m)
da = 0.1 #distance point charge-plate (m)
width = 0.1 # width plates (m)
iterations = 30 # iterations for the relaxation
divisions= 10 # height division for z dependence


# functions 
@njit
def neumann(a):
    """Apply Neumann boundary conditions."""
    a[0, :, :] = a[1, :, :]
    a[-1, :, :] = a[-2, :, :]
    a[:, 0, :] = a[:, 1, :]
    a[:, -1, :] = a[:, -2, :]
    a[:, :, 0] = a[:, :, 1]
    a[:, :, -1] = a[:, :, -2]
    return a

def laplace(d, V0, q, L, point_density, size_grid, da, width, iterations):
    """Calculate the potential."""
    epsilon_0 = 8.8541878188e-12  # Vacuum permittivity (F/m)
    e = 1.602e-19  # Elementary charge in coulombs
    
    L = int(point_density * L)
    d = int(point_density * d)
    dp = [int(point_density * (size_grid / 2)), 
          int(point_density * (size_grid / 2)), 
          int(point_density * (size_grid / 2 - d / 2 + da))]
    N = int(point_density * size_grid)
    w = int(point_density * width)
    m = N // 2
    charge_density = q * e / 18  # Charge density of the little cube
    Vq = charge_density / epsilon_0  # Potential of the cube

    if L > size_grid * point_density:
        print('Capacitor size off the grid')
    if d + 2 * w > size_grid * point_density:
        print('Capacitor separation off the grid')

    grid = np.full((N, N, N), V0 / 2)  # Initial guess for potential

    if w != 0:
        for x in range(w):
            grid[m - L // 2:m + L // 2, m - L // 2:m + L // 2, m - d // 2 - x] = V0
            grid[m - L // 2:m + L // 2, m - L // 2:m + L // 2, m + d // 2 + x] = 0
    else:
        grid[m - L // 2:m + L // 2, m - L // 2:m + L // 2, m - d // 2] = V0
        grid[m - L // 2:m + L // 2, m - L // 2:m + L // 2, m + d // 2] = 0

    mask_pos = grid == V0
    mask_neg = grid == 0

    if Vq != 0:
        grid[dp[0] - 1:dp[0] + 2, dp[1] - 1:dp[1] + 2, dp[2] - 1:dp[2] + 2] = Vq
        mask_q = grid == Vq

    # Generate initial conditions for potential
    _, _, zv = np.meshgrid(np.arange(N), np.arange(N), np.arange(N))
    grid = 1 - zv / 100  # Linear approximation to mimic potential decay
    kern = generate_binary_structure(3, 1).astype(float) / 6
    kern[1, 1, 1] = 0

    # Iterative solution for the potential
    err = []
    for _ in range(iterations):
        grid_updated = convolve(grid, kern, mode='constant')
        grid_updated = neumann(grid_updated)
        grid_updated[mask_pos] = V0
        grid_updated[mask_neg] = 0
        if Vq != 0:
            grid_updated[mask_q] = Vq
        err.append(np.mean((grid - grid_updated) ** 2))
        grid = grid_updated

    # Compute electric field
    dx = dy = dz = 1 / point_density
    E_z, E_y, E_x = np.gradient(-grid, dx, axis=(0, 1, 2))
    
    # Compute electric flux density
    D_x, D_y, D_z = epsilon_0 * E_x, epsilon_0 * E_y, epsilon_0 * E_z
    
    # Compute energy density
    energy_density = 0.5 * (D_x * E_x + D_y * E_y + D_z * E_z)
    W = np.sum(energy_density[m - L // 2:m + L // 2, 
                              m - L // 2:m + L // 2, 
                              N // 2 - d // 2:N // 2 + d // 2]) * dx * dy * dz
    
    # Capacitance calculation
    C = (2e12) * W / V0 ** 2  # Convert to pF
    C = round(C, 2)
    print(f"Capacitance: {C} pF")
    
    return grid, C


#plotting

start_time = time.time()

z = np.linspace(0.2, d, divisions)  #points z pot (m)
pot1, cap1 = laplace(z[-1],V0, q, L, point_density,size_grid ,da,width, iterations) 
NN = len(pot1[0])
slc = NN // 2  # Middle slice of the grid

# Plot the contour
plt.figure(figsize=(6, 5))
CS = plt.contour(np.arange(NN) / NN, np.arange(NN) / NN, pot1[slc], levels=50, cmap='coolwarm')
plt.clabel(CS, CS.levels, inline=True, fontsize=6)
plt.plot((NN / 2 + int(z[-1] * point_density) // 2 - 1)/ NN, slc / NN, 'ko' )
plt.xlabel("$z (m)$")
plt.ylabel("$y (m)$")
plt.title("Contour of Potential at Midplane (d="+str(z[-1])+' A)')
plt.colorbar(label="Potential (V)")
plt.show()

# Calculate and plot potential and capacitance vs plate separation
potential = []
C = []

for x in z:
    grid, cap = laplace(x,V0, q, L , point_density,size_grid,da,width, iterations)
    cap = round(cap, 2)
    slc_pos = int(NN / 2 + int(x * point_density) // 2 - 1)  # position one point below the plate that moves to obtain the potential there
    pot2 = round(grid[slc, slc, slc_pos], 3)  # Potential at the center
    potential.append(pot2)
    C.append(cap)
    print(f"Z = {x:.2f} m | V = {pot2:.3f} V | C = {cap:.2f} pF")

# Plot potential and capacitance vs plate separation side by side
fig, axs = plt.subplots(1, 2, figsize=(14, 6), sharex=True)

# Plot potential vs plate separation
axs[0].plot(z, potential, label="Potential at Center", marker="o", color='tab:blue')
axs[0].set_xlabel("Plate Separation (m)", fontsize=12)
axs[0].set_ylabel("Potential (V)", fontsize=12)
axs[0].set_title("Potential vs Plate Separation", fontsize=14)
axs[0].legend()
axs[0].grid(True)

# Plot capacitance vs plate separation
axs[1].plot(z, C, label="Capacitance", marker="s", color='tab:orange')
axs[1].set_xlabel("Plate Separation (m)", fontsize=12)
axs[1].set_ylabel("Capacitance (pF)", fontsize=12)
axs[1].set_title("Capacitance vs Plate Separation", fontsize=14)
axs[1].legend()
axs[1].grid(True)

# Adjust layout
plt.tight_layout()
plt.show()

end_time = time.time()

# Print elapsed time
print(f"Time taken: {end_time - start_time:.4f} seconds")



















